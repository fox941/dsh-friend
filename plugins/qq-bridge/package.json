    "./media": "./src/qq-media.js",
    "./helper": "./src/qq-helper-client.js",
    "./accounts": "./src/accounts.js",
    "./social": "./src/social.js",
    "./audio-runtime": "./src/audio-runtime.js",
    "./transport": "./vendor/dsh-onebot/connection.js",
    "./napcat-helper": "./napcat/qq-social-helper/index.mjs",
    "./social-memory": "./src/social-memory.js",
    "./social-native": "./src/social-native.js",
    "./social-memory-store": "./src/social-memory-store.js",
    "./social-memory-inspect": "./src/social-memory-inspect.js",
    "./social-lifecycle": "./src/social-lifecycle.js",
    "./profile-actions": "./src/profile-actions.js",
    "./qzone-read": "./src/qzone-read.js",
