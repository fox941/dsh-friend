{
  "name": "@ai-friend/activity-console",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "统一活动中心：选择、待办、执行回执、资源与受控活动配置。",
  "exports": {
    ".": "./src/index.js",
    "./registry": "./src/registry.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
